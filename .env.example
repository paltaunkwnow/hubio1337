# xd
# Hubio — copy to .env (never commit real secrets)

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/hubio_db?schema=public"
NEXTAUTH_SECRET="generate-a-strong-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth (Google OAuth) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@hubio.lat"
INVESTOR_CONTACT_EMAIL=""

# ── Hubio AI Engine ────────────────────────────────────────────────────
AI_PROVIDER="agentrouter"
AI_BASE_URL="https://agentrouter.org/v1"
AI_API_KEY=""
AI_MODEL="gpt-5.5"
# Optional fallbacks / alternates (same OpenAI-compatible shape)
OPENAI_API_KEY=""

# ── Optional AI tools (Hubio Tools) ────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
GOOGLE_PAGESPEED_API_KEY=""

# Gemini (provider nativo; también entra al fallback chain si hay key)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Ollama local (provider nativo; se activa si hay OLLAMA_BASE_URL u OLLAMA_MODEL)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Caché IA Redis-ready (opcional). Sin ioredis instalado usa memoria + warning.
# AI_CACHE_URL="redis://localhost:6379"

# Cron de insights IA: Authorization: Bearer <CRON_SECRET> en /api/ai/cron/insights
CRON_SECRET=""

# ── Wallet / USDT (optional modules) ───────────────────────────────────
WALLET_TRON_ADDRESS=""
WALLBIT_API_KEY=""
WALLBIT_MCP_URL="https://mcp.wallbit.io/mcp"
WALLBIT_API_BASE_URL="https://api.wallbit.io/api/public/v1"
WITHDRAWAL_MIN_BOB="45"
WITHDRAWAL_FEE_BOB="5"
# WITHDRAWAL_FEE_PERCENT="2"
CRYPTO_PAYMENT_EXPIRY_MINUTES="60"
POS_PLATFORM_COMMISSION_PERCENT="2"
USDT_BOB_RATE="11.37"
